# Runtime
NODE_ENV=development
PORT=3001
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_TENANT_SLUG=blades

# PostgreSQL
DATABASE_URL=postgresql://barbershop:barbershop@localhost:5432/barbershop?schema=public

# Authentication and security (replace with at least 32 random characters)
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=barbershop-api
JWT_AUDIENCE=barbershop-admin
SESSION_TTL_MINUTES=480

# Payments and subscriptions. The mock provider is development-only.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-this-with-a-different-random-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Files. Use s3 in production.
FILE_STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=.data/uploads
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Initial bootstrap accounts (development values must be changed)
SEED_OWNER_PASSWORD=replace-this-owner-password
SEED_PLATFORM_PASSWORD=replace-this-platform-password

# Client
VITE_API_URL=/api
VITE_TENANT_SLUG=blades
